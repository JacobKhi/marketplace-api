// Define uma variável com a URL base da nossa API para não precisar repetir
@baseUrl = http://localhost:8080

###

# =================================================================
# ETAPA 1: CADASTRO DOS USUÁRIOS
# =================================================================

# 1.1 - Criar Usuário VENDEDOR
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "nome": "Loja de Eletrônicos Tuds",
  "email": "vendedor@email.com",
  "senha": "senha_vendedor",
  "telefone": "11988887777",
  "documento": "11222333000144",
  "perfil": "VENDEDOR"
}

###

# 1.2 - Criar Usuário COMPRADOR
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "nome": "Fulano da Silva",
  "email": "comprador@email.com",
  "senha": "senha_comprador",
  "telefone": "22999995555",
  "documento": "12345678900",
  "perfil": "COMPRADOR"
}

###

# 1.3 - Criar Usuário ADMINISTRADOR
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "nome": "Admin do Sistema",
  "email": "admin@email.com",
  "senha": "senha_admin",
  "telefone": "11911112222",
  "documento": "11122233300",
  "perfil": "ADMINISTRADOR"
}

###

# =================================================================
# ETAPA 2: LOGINS (Para obter os Tokens)
# =================================================================

# 2.1 - Login VENDEDOR
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "vendedor@email.com",
  "senha": "senha_vendedor"
}
> {% client.global.set("vendedor_token", response.body); %}

###

# 2.2 - Login COMPRADOR
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "comprador@email.com",
  "senha": "senha_comprador"
}
> {% client.global.set("comprador_token", response.body); %}

###

# 2.3 - Login ADMINISTRADOR
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "admin@email.com",
  "senha": "senha_admin"
}
> {% client.global.set("admin_token", response.body); %}

###

# =================================================================
# ETAPA 3: FLUXO DO VENDEDOR
# =================================================================

# 3.1 - Criar uma Categoria
POST {{baseUrl}}/categorias
Content-Type: application/json
Authorization: Bearer {{vendedor_token}}

{
  "nome": "Smartphones",
  "descricao": "Celulares e smartphones de última geração"
}

###

# 3.2 - Criar um Produto
POST {{baseUrl}}/produtos
Content-Type: application/json
Authorization: Bearer {{vendedor_token}}

{
  "nome": "SuperPhone Pro Max",
  "descricao": "O melhor smartphone do mercado com câmera tripla.",
  "preco": 4500.00,
  "estoque": 50,
  "categoriaId": 1,
  "vendedorId": 1
}

###

# =================================================================
# ETAPA 4: FLUXO DO COMPRADOR
# =================================================================

# 4.1 - Atualizar o próprio perfil (ID 2 do comprador)
PUT {{baseUrl}}/usuarios/2
Content-Type: application/json
Authorization: Bearer {{comprador_token}}

{
  "nome": "Fulano da Silva Santos",
  "telefone": "22987654321"
}

###

# 4.2 - Criar um Pedido
POST {{baseUrl}}/pedidos
Content-Type: application/json
Authorization: Bearer {{comprador_token}}

{
  "compradorId": 2,
  "itens": [
    {
      "produtoId": 1,
      "quantidade": 1
    }
  ]
}

###

# 4.3 - Criar uma Avaliação
POST {{baseUrl}}/avaliacoes
Content-Type: application/json
Authorization: Bearer {{comprador_token}}

{
  "pedidoId": 1,
  "avaliadorId": 2,
  "nota": 5,
  "comentario": "Chegou muito rápido, produto excelente!"
}

###

# =================================================================
# ETAPA 5: TESTES DE SEGURANÇA DO ADMIN
# =================================================================

# 5.1 - Acessar rota de admin como COMPRADOR (DEVE FALHAR COM 403)
GET {{baseUrl}}/usuarios/admin/todos
Authorization: Bearer {{comprador_token}}

###

# 5.2 - Acessar rota de admin como ADMIN (DEVE FUNCIONAR COM 200)
GET {{baseUrl}}/usuarios/admin/todos
Authorization: Bearer {{admin_token}}

###

### =================================================================
### ETAPA 6: FLUXO DE RECUPERAÇÃO DE SENHA
### =================================================================

### 6.1 - Solicitar o token de recuperação
POST {{baseUrl}}/usuarios/forgot-password
Content-Type: application/json

{
  "email": "comprador@email.com"
}

> {%
    let responseBody = response.body;
    let token = responseBody.substring(responseBody.indexOf(':') + 2);
    client.global.set("reset_token", token);
%}

###

### 6.2 - Efetuar o reset da senha
# Usamos o token que pegamos no passo anterior e definimos uma nova senha.
# Se funcionar, a resposta deve ser 200 OK com uma mensagem de sucesso.
POST {{baseUrl}}/usuarios/reset-password
Content-Type: application/json

{
  "token": "{{reset_token}}",
  "novaSenha": "nova_senha_123"
}

###

### =================================================================
### ETAPA 7: TESTES DE EDIÇÃO DE PRODUTO
### =================================================================

### 7.1 - Tentar editar produto de outro usuário (DEVE FALHAR)
# Logados como COMPRADOR, vamos tentar editar o produto (ID 1)
# que pertence ao VENDEDOR.
# A resposta esperada é um erro.
PUT {{baseUrl}}/produtos/1
Content-Type: application/json
Authorization: Bearer {{comprador_token}}

{
  "nome": "Produto Editado por Intruso",
  "descricao": "Tentando hackear o sistema.",
  "preco": 1.00,
  "estoque": 1
}

###

### 7.2 - Editar o próprio produto (DEVE FUNCIONAR)
# Agora, logados como VENDEDOR (o dono), vamos editar o mesmo produto (ID 1).
# A resposta esperada é 200 OK com os dados do produto atualizado.
PUT {{baseUrl}}/produtos/1
Content-Type: application/json
Authorization: Bearer {{vendedor_token}}

{
  "nome": "SuperPhone Pro Max 2.0",
  "descricao": "A nova versão, agora com mais bateria!",
  "preco": 4750.00,
  "estoque": 49
}

###

### =================================================================
### ETAPA 8: TESTES DE DELEÇÃO DE PRODUTO
### =================================================================

### 8.1 - Tentar deletar produto de outro usuário (DEVE FALHAR)
# Logados como COMPRADOR, vamos tentar deletar o produto (ID 1) do VENDEDOR.
# A resposta esperada é um erro (provavelmente 500 ou 403).
DELETE {{baseUrl}}/produtos/1
Authorization: Bearer {{comprador_token}}

###

### 8.2 - Deletar o próprio produto (DEVE FUNCIONAR)
# Agora, logados como VENDEDOR (o dono), vamos deletar o mesmo produto (ID 1).
# A resposta esperada é 204 No Content (sucesso, sem corpo de resposta).
DELETE {{baseUrl}}/produtos/1
Authorization: Bearer {{vendedor_token}}

###

